{
    "name": "n8n-nodes-sqlite-manager",
    "version": "0.1.0",
    "description": "Manage SQLite databases from n8n workflows",
    "license": "MIT",
    "homepage": "https://flows.automators.work",
    "keywords": [
        "n8n-community-node-package",
        "sqlite",
        "database",
        "automation"
    ],
    "author": {
        "name": "Automators Workflows",
        "email": "devops@automators.work"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/automators-work/n8n-nodes-sqlite-manager"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "credentials": [],
        "nodes": [
            "dist/nodes/SqliteManager/SqliteManager.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "@types/node": "^24.7.2",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
